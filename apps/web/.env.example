NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer the publishable key; the legacy anon key is used when it is absent.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GATEWAY_HMAC_SECRET=replace-with-at-least-32-random-characters
GATEWAY_ADMIN_TOKEN=replace-with-at-least-32-random-characters
SUPPORT_WA_ID=923001234567@c.us
ADMIN_EMAIL=owner@example.com
STORE_CURRENCY=PKR
# Gemini powers AI suggestions for product images (admin + import --suggest).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
